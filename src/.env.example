# Copy this file to src/backend/.env and fill in your actual values if using live watsonx.ai
# If left as placeholders, the application runs fully with deterministic clinical fallback rules.
# NEVER commit real credentials to version control.

# ── IBM watsonx.ai Configuration ──────────────────────────────────────────────
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ── Database Configuration ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./venopump.db

# ── Application Settings ──────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# ── Frontend Settings (Vite) ──────────────────────────────────────────────────
# Set in src/frontend/.env.local or frontend environment
VITE_API_BASE_URL=http://localhost:8000/api/v1
