# Copy this file to src/backend/.env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── IBM watsonx.ai (required for Phase 4 AI features) ─────────────────────────
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./venopump.db

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite — prefix with VITE_ to expose to browser) ──────────────────
# Set in src/frontend/.env.local for local dev
VITE_API_BASE_URL=http://localhost:8000/api/v1
